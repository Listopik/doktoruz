# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true

# Session signing (long random string)
SESSION_SECRET=change-this-to-a-long-random-secret

# Main admin
MASTER_ADMIN_PHONE=998933763262
ADMIN_PASSWORD_HASH=scrypt$16384$8$1$aWlghewJqLk8P6CA6Bxd_Q$6odGrV-T9zy0ACMlpxLSU9gzaKQK04b8l2kTVAywfYo

# SMS
# demo = OTP appears in the response for testing
# twilio = real SMS through Twilio Verify
SMS_MODE=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# One-time setup endpoint
SETUP_TOKEN=change-this-setup-token
SETUP_ENABLED=true

# Optional public media storage (Cloudinary direct upload is configured in the HTML)
# DOKTORUZ_CLOUDINARY_CLOUD_NAME=
# DOKTORUZ_CLOUDINARY_UPLOAD_PRESET=
